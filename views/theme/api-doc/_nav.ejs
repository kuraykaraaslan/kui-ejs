<%
  var _spec       = locals.spec       || {};
  var _activePage = locals.activePage || 'index';

  var info = _spec.info || {};

  var statusVariant = {
    ACTIVE:     'bg-success-subtle text-success-fg',
    DRAFT:      'bg-warning-subtle text-warning-fg',
    DEPRECATED: 'bg-error-subtle text-error-fg',
    SUNSET:     'bg-surface-overlay text-text-secondary',
  };
  var statusCls = statusVariant[_spec.status] || 'bg-surface-overlay text-text-secondary';

  var drawerId = 'api-doc-mobile-nav';
%>

<div class="flex h-screen overflow-hidden bg-surface-base">

  <!-- Desktop sidebar -->
  <aside class="hidden lg:flex w-72 shrink-0 flex-col border-r border-border bg-surface-raised overflow-hidden">
    <%- include('./_sidebar-body', { spec: _spec, searchId: 'api-nav-search', navAriaLabel: 'API endpoints', showBrand: true }) %>
  </aside>

  <!-- Mobile drawer -->
  <div id="<%= drawerId %>"
       class="fixed inset-0 z-[100] flex lg:hidden opacity-0 pointer-events-none transition-opacity duration-200"
       role="dialog" aria-modal="true" aria-label="API navigation">
    <div class="absolute inset-0 bg-black/50" aria-hidden="true" onclick="closeDrawer('<%= drawerId %>')"></div>
    <aside id="<%= drawerId %>-panel" tabindex="-1"
           class="relative flex flex-col w-80 max-w-full h-full bg-surface-raised border-r border-border shadow-xl transition-transform duration-200 -translate-x-full overflow-hidden focus-visible:outline-none">
      <button type="button" aria-label="Close navigation" onclick="closeDrawer('<%= drawerId %>')"
              class="absolute top-2 right-2 z-10 inline-flex h-9 w-9 items-center justify-center rounded-md text-text-secondary hover:text-text-primary hover:bg-surface-overlay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <%- include('./_sidebar-body', { spec: _spec, searchId: 'api-drawer-search', navAriaLabel: 'API endpoints (mobile)', showBrand: true }) %>
    </aside>
  </div>

  <script>
  (function(){
    function openDrawer(id){var el=document.getElementById(id);var p=document.getElementById(id+'-panel');if(!el||!p)return;el.classList.remove('opacity-0','pointer-events-none');el.classList.add('opacity-100');p.classList.remove('translate-x-full','-translate-x-full');p.classList.add('translate-x-0');var first=p.querySelector('a,button,input,[tabindex]:not([tabindex="-1"])');if(first)first.focus();else p.focus();}
    function closeDrawer(id){var el=document.getElementById(id);var p=document.getElementById(id+'-panel');if(!el||!p)return;var isRight=p.classList.contains('ml-auto');el.classList.add('opacity-0','pointer-events-none');el.classList.remove('opacity-100');p.classList.remove('translate-x-0');p.classList.add(isRight?'translate-x-full':'-translate-x-full');}
    window.openDrawer=window.openDrawer||openDrawer;
    window.closeDrawer=window.closeDrawer||closeDrawer;
    document.addEventListener('keydown',function(e){if(e.key!=='Escape')return;document.querySelectorAll('[role="dialog"][aria-modal="true"]').forEach(function(el){if(!el.classList.contains('opacity-0'))window.closeDrawer(el.id);});});
  })();
  </script>

  <!-- Endpoint filter: wires every endpoint-search input to every API endpoints nav (desktop + mobile drawer) -->
  <script>(function(){
    var navs = Array.prototype.slice.call(document.querySelectorAll('nav[aria-label^="API endpoints"]'));
    if (!navs.length) return;
    var inputs = [
      document.getElementById('api-nav-search'),
      document.getElementById('api-drawer-search'),
      document.getElementById('api-topbar-search'),
    ].filter(Boolean);
    if (!inputs.length) return;

    navs.forEach(function(nav) {
      var emptyMsg = document.createElement('p');
      emptyMsg.className = 'px-3 py-6 text-xs text-text-disabled text-center hidden';
      emptyMsg.setAttribute('data-api-search-empty', '');
      nav.insertBefore(emptyMsg, nav.firstChild);
      nav._apiEmpty = emptyMsg;
    });

    function applyOne(nav, query) {
      var q = (query || '').trim().toLowerCase();
      var anyMatch = false;
      nav.querySelectorAll('details').forEach(function(d) {
        var summaryText = (d.querySelector('summary span') || {}).textContent || '';
        var tagMatches = q === '' || summaryText.toLowerCase().indexOf(q) !== -1;
        var hasMatchingItem = false;
        d.querySelectorAll('li').forEach(function(li) {
          var path    = (li.querySelector('p.font-mono')         || {}).textContent || '';
          var summary = (li.querySelector('p.text-\\[10px\\]')    || {}).textContent || '';
          var hit = q === '' || tagMatches || (path + ' ' + summary).toLowerCase().indexOf(q) !== -1;
          li.classList.toggle('hidden', !hit);
          if (hit) hasMatchingItem = true;
        });
        var visible = tagMatches || hasMatchingItem;
        d.classList.toggle('hidden', !visible);
        if (visible) anyMatch = true;
        if (q !== '' && !tagMatches && hasMatchingItem) d.setAttribute('open', '');
      });
      if (nav._apiEmpty) {
        nav._apiEmpty.textContent = 'No results for "' + (query || '') + '"';
        nav._apiEmpty.classList.toggle('hidden', q === '' || anyMatch);
      }
    }

    function apply(query) { navs.forEach(function(n){ applyOne(n, query); }); }

    inputs.forEach(function(input) {
      input.addEventListener('input', function(e) {
        var v = e.target.value;
        inputs.forEach(function(other) { if (other !== input && other.value !== v) other.value = v; });
        apply(v);
      });
    });
  })();</script>

  <!-- Main column -->
  <div class="flex-1 flex flex-col min-w-0">

    <!-- Top bar -->
    <header class="flex h-14 items-center gap-3 px-4 sm:px-6 border-b border-border bg-surface-raised shrink-0">

      <!-- Mobile hamburger -->
      <button type="button" onclick="openDrawer('<%= drawerId %>')"
              aria-label="Open navigation"
              class="inline-flex lg:hidden items-center justify-center w-9 h-9 rounded-md text-text-secondary hover:text-text-primary hover:bg-surface-overlay transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus shrink-0">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>

      <!-- Mobile title -->
      <div class="flex items-center gap-2 lg:hidden min-w-0">
        <i class="fa-solid fa-book w-4 h-4 text-primary shrink-0 text-sm" aria-hidden="true"></i>
        <span class="text-sm font-semibold text-text-primary truncate"><%= info.title || 'API Docs' %></span>
      </div>

      <!-- Desktop search -->
      <div class="hidden lg:flex flex-1 max-w-xs">
        <%- include('../../../modules/ui/SearchBar', {
          id: 'api-topbar-search',
          placeholder: 'Filter endpoints…',
          className: 'w-full'
        }) %>
      </div>

      <!-- Right side -->
      <div class="ml-auto flex items-center gap-3 shrink-0">
        <span class="hidden sm:block text-xs font-mono text-text-disabled">OpenAPI <%= _spec.openapi || '3.1.0' %></span>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= statusCls %>"><%= _spec.status || 'DRAFT' %></span>
        <% if (info.contact && info.contact.email) { %>
          <a href="mailto:<%= info.contact.email %>"
             class="hidden md:block text-xs text-text-secondary hover:text-primary transition-colors">
            <%= info.contact.name || info.contact.email %>
          </a>
        <% } %>
      </div>
    </header>

    <main id="main-content" class="flex-1 overflow-y-auto">
