<%
  var _activePage = locals.activePage || '';
  var _state      = locals.state      || {};
  var _unread     = (_state.alerts || []).filter(function(a) { return !a.read; }).length;

  var nav = [
    { id: 'dashboard', label: 'Dashboard',         href: '/theme/modem',           icon: 'fa-solid fa-gauge'          },
    { id: 'network',   label: 'Network',            href: '/theme/modem/network',   icon: 'fa-solid fa-network-wired'  },
    { id: 'wifi',      label: 'Wi-Fi',              href: '/theme/modem/wifi',      icon: 'fa-solid fa-wifi'           },
    { id: 'devices',   label: 'Devices',            href: '/theme/modem/devices',   icon: 'fa-solid fa-display'        },
    { id: 'firewall',  label: 'Firewall',           href: '/theme/modem/firewall',  icon: 'fa-solid fa-shield-halved'  },
    { id: 'nat',       label: 'NAT',                href: '/theme/modem/nat',       icon: 'fa-solid fa-right-left'     },
    { id: 'vpn',       label: 'VPN',                href: '/theme/modem/vpn',       icon: 'fa-solid fa-lock'           },
    { id: 'qos',       label: 'QoS',                href: '/theme/modem/qos',       icon: 'fa-solid fa-sliders'        },
    { id: 'parental',  label: 'Parental Controls',  href: '/theme/modem/parental',  icon: 'fa-solid fa-shield-child'   },
    { id: 'system',    label: 'System',             href: '/theme/modem/system',    icon: 'fa-solid fa-microchip'      },
    { id: 'settings',  label: 'Settings',           href: '/theme/modem/settings',  icon: 'fa-solid fa-gear'           },
  ];

  var activeNav = nav.find(function(n) { return n.id === _activePage; });
  var drawerId  = 'modem-mobile-nav';
%>

<div class="flex h-screen overflow-hidden bg-surface-base">

  <!-- Desktop sidebar -->
  <aside class="hidden md:flex w-56 shrink-0 flex-col border-r border-border bg-surface-raised">
    <%- include('./_sidebar-body', { state: _state, nav: nav, activePage: _activePage, unread: _unread }) %>
  </aside>

  <!-- Mobile drawer (mirrors modules/app/AppDrawer wiring) -->
  <div id="<%= drawerId %>"
       class="fixed inset-0 z-[100] flex md:hidden opacity-0 pointer-events-none transition-opacity duration-200"
       role="dialog" aria-modal="true" aria-label="Modem navigation">
    <div class="absolute inset-0 bg-black/50" aria-hidden="true" onclick="closeDrawer('<%= drawerId %>')"></div>
    <aside id="<%= drawerId %>-panel" tabindex="-1"
           class="relative flex flex-col w-72 max-w-full h-full bg-surface-raised border-r border-border shadow-xl transition-transform duration-200 -translate-x-full focus-visible:outline-none">
      <button type="button" aria-label="Close navigation" onclick="closeDrawer('<%= drawerId %>')"
              class="absolute top-2 right-2 z-10 inline-flex h-9 w-9 items-center justify-center rounded-md text-text-secondary hover:text-text-primary hover:bg-surface-overlay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <%- include('./_sidebar-body', { state: _state, nav: nav, activePage: _activePage, unread: _unread }) %>
    </aside>
  </div>

  <script>
  (function(){
    function openDrawer(id){var el=document.getElementById(id);var p=document.getElementById(id+'-panel');if(!el||!p)return;el.classList.remove('opacity-0','pointer-events-none');el.classList.add('opacity-100');p.classList.remove('translate-x-full','-translate-x-full');p.classList.add('translate-x-0');var first=p.querySelector('a,button,input,[tabindex]:not([tabindex="-1"])');if(first)first.focus();else p.focus();}
    function closeDrawer(id){var el=document.getElementById(id);var p=document.getElementById(id+'-panel');if(!el||!p)return;var isRight=p.classList.contains('ml-auto');el.classList.add('opacity-0','pointer-events-none');el.classList.remove('opacity-100');p.classList.remove('translate-x-0');p.classList.add(isRight?'translate-x-full':'-translate-x-full');}
    window.openDrawer=window.openDrawer||openDrawer;
    window.closeDrawer=window.closeDrawer||closeDrawer;
    document.addEventListener('keydown',function(e){if(e.key!=='Escape')return;document.querySelectorAll('[role="dialog"][aria-modal="true"]').forEach(function(el){if(!el.classList.contains('opacity-0'))window.closeDrawer(el.id);});});
  })();
  </script>

  <!-- Main column -->
  <div class="flex-1 flex flex-col min-w-0">

    <header class="flex h-14 items-center gap-3 border-b border-border px-4 sm:px-6 bg-surface-raised shrink-0">
      <button type="button" onclick="openDrawer('<%= drawerId %>')"
              aria-label="Open navigation"
              class="inline-flex md:hidden items-center justify-center w-9 h-9 rounded-md text-text-secondary hover:text-text-primary hover:bg-surface-overlay transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus shrink-0">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <div class="min-w-0 flex-1">
        <a href="/theme/modem" class="text-xs text-text-secondary hover:text-text-primary transition-colors">
          <i class="fa-solid fa-arrow-left text-xs mr-1" aria-hidden="true"></i>Modem Theme
        </a>
        <h1 class="text-base font-bold text-text-primary mt-0.5 leading-none">
          <%= activeNav ? activeNav.label : 'Dashboard' %>
        </h1>
      </div>
      <% if (_unread > 0) { %>
      <a href="/theme/modem"
         class="flex items-center gap-2 rounded-lg bg-error/10 border border-error/20 px-3 py-1.5 text-xs font-medium text-error hover:bg-error/20 transition-colors shrink-0">
        <i class="fa-solid fa-bell" aria-hidden="true"></i>
        <%= _unread %> alert<%= _unread > 1 ? 's' : '' %>
      </a>
      <% } %>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6">
