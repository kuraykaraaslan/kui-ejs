<!DOCTYPE html>
<html lang="en" class="<%= locals.theme === 'dark' ? 'dark' : '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <!-- SEO -->
  <meta name="description" content="<%= site.description %>" />
  <meta name="keywords" content="<%= site.keywords %>" />
  <meta name="author" content="<%= site.author %>" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="<%= site.url %>" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= site.name %>" />
  <meta property="og:title" content="<%= site.longTitle %>" />
  <meta property="og:description" content="<%= site.description %>" />
  <meta property="og:url" content="<%= site.url %>" />
  <meta property="og:image" content="<%= site.url %>/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="<%= site.name %> Preview" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= site.longTitle %>" />
  <meta name="twitter:description" content="<%= site.description %>" />
  <meta name="twitter:image" content="<%= site.url %>/og-image.png" />
  <meta name="twitter:creator" content="<%= site.twitterHandle %>" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "WebSite", "url": site.url, "name": site.name, "description": site.description },
      { "@type": "Person", "name": site.author, "url": site.authorUrl },
      { "@type": "SoftwareApplication", "name": site.name, "applicationCategory": "DeveloperApplication", "operatingSystem": "Web", "description": site.description, "url": site.url, "creator": { "@type": "Person", "name": site.author } }
    ]
  }) %>
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/assets/css/app.css?v=<%= assetVersion %>" />
  <% if (locals.colorOverrideCss) { %>
  <style id="showcase-color-overrides"><%- colorOverrideCss %></style>
  <% } %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="anonymous" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" crossorigin="anonymous" />
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js" crossorigin="anonymous"></script>
  <style id="kui-quill-overrides">
    /* Quill snow theme remapped to project tokens — must match React side. */
    .ql-toolbar.ql-snow { background: var(--surface-sunken); border: none; border-bottom: 1px solid var(--border); padding: 6px 8px; }
    .ql-container.ql-snow { border: none; background: var(--surface-base); color: var(--text-primary); font-family: inherit; font-size: 0.875rem; }
    .ql-editor { color: var(--text-primary); padding: 12px 16px; }
    .ql-editor.ql-blank::before { color: var(--text-disabled); font-style: normal; left: 16px; right: 16px; }
    .ql-snow .ql-stroke { stroke: var(--text-primary); }
    .ql-snow .ql-fill, .ql-snow .ql-stroke.ql-fill { fill: var(--text-primary); }
    .ql-snow .ql-picker { color: var(--text-primary); }
    .ql-snow .ql-picker-options { background: var(--surface-base); border-color: var(--border); color: var(--text-primary); }
    .ql-snow .ql-picker-label { border: none; }
    .ql-snow .ql-picker-label:hover, .ql-snow .ql-picker-item:hover { color: var(--primary); }
    .ql-snow button:hover, .ql-snow button:focus { color: var(--primary); }
    .ql-snow button.ql-active, .ql-snow .ql-picker-label.ql-active, .ql-snow .ql-picker-item.ql-selected { color: var(--primary); }
    .ql-snow button:hover .ql-stroke, .ql-snow button:focus .ql-stroke, .ql-snow button.ql-active .ql-stroke,
    .ql-snow .ql-picker-label:hover .ql-stroke, .ql-snow .ql-picker-label.ql-active .ql-stroke { stroke: var(--primary); }
    .ql-snow button:hover .ql-fill, .ql-snow button:focus .ql-fill, .ql-snow button.ql-active .ql-fill,
    .ql-snow .ql-picker-label:hover .ql-fill, .ql-snow .ql-picker-label.ql-active .ql-fill { fill: var(--primary); }
    .ql-snow .ql-tooltip { background: var(--surface-raised); border: 1px solid var(--border); color: var(--text-primary); box-shadow: 0 4px 12px rgb(0 0 0 / 0.08); border-radius: 6px; }
    .ql-snow .ql-tooltip input[type=text] { background: var(--surface-base); border: 1px solid var(--border); color: var(--text-primary); border-radius: 4px; }
    .ql-snow .ql-tooltip a.ql-action, .ql-snow .ql-tooltip a.ql-remove { color: var(--primary); }
    /* Active state on the Tailwind-styled toolbar buttons */
    .ql-snow .kui-rte-btn.ql-active { background: var(--primary-subtle); color: var(--primary); }
    /* Tables emitted by the table modal */
    .kui-rte-content table.kui-rte-table, .ql-editor table.kui-rte-table { width: 100%; border-collapse: collapse; margin: 0.5em 0; }
    .kui-rte-content table.kui-rte-table th, .kui-rte-content table.kui-rte-table td, .ql-editor table.kui-rte-table th, .ql-editor table.kui-rte-table td { border: 1px solid var(--border); padding: 0.4em 0.6em; min-width: 3rem; vertical-align: top; }
    .kui-rte-content table.kui-rte-table th, .ql-editor table.kui-rte-table th { background: var(--surface-overlay); font-weight: 600; text-align: left; }
    /* Horizontal rule */
    .kui-rte-content hr, .ql-editor hr { border: none; border-top: 1px solid var(--border); margin: 0.75em 0; }
    /* Mention chip */
    .kui-rte-content .kui-rte-mention, .ql-editor .kui-rte-mention { display: inline-block; padding: 0.05em 0.4em; border-radius: 9999px; background: var(--primary-subtle); color: var(--primary); font-weight: 500; font-size: 0.875em; white-space: nowrap; }
    /* Images */
    .kui-rte-content img, .ql-editor img { max-width: 100%; height: auto; }
    /* Suggestion popups + bubble menu + image overlay (fixed-positioned, attached to body) */
    .kui-rte-popup { background: var(--surface-raised); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 4px 12px rgb(0 0 0 / 0.12); z-index: 60; }
    .kui-rte-popup .kui-rte-item { padding: 0.5rem 0.75rem; cursor: pointer; display: flex; gap: 0.5rem; align-items: center; font-size: 0.875rem; color: var(--text-primary); }
    .kui-rte-popup .kui-rte-item:hover, .kui-rte-popup .kui-rte-item[aria-selected="true"] { background: var(--primary-subtle); color: var(--primary); }
    .kui-rte-popup .kui-rte-item .kui-rte-item-desc { color: var(--text-secondary); font-size: 0.75rem; }
    .kui-rte-popup.kui-rte-bubble { display: inline-flex; gap: 0.125rem; padding: 0.25rem; align-items: center; }
    .kui-rte-popup.kui-rte-bubble button { width: 1.75rem; height: 1.75rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 0.25rem; color: var(--text-primary); background: transparent; border: none; cursor: pointer; }
    .kui-rte-popup.kui-rte-bubble button:hover, .kui-rte-popup.kui-rte-bubble button.is-active { background: var(--primary-subtle); color: var(--primary); }
    .kui-rte-popup.kui-rte-emoji { display: grid; grid-template-columns: repeat(8, 1.75rem); gap: 0.125rem; padding: 0.5rem; max-height: 18rem; overflow-y: auto; }
    .kui-rte-popup.kui-rte-emoji button { width: 1.75rem; height: 1.75rem; font-size: 1.125rem; line-height: 1; background: transparent; border: none; border-radius: 0.25rem; cursor: pointer; }
    .kui-rte-popup.kui-rte-emoji button:hover { background: var(--surface-overlay); }
    /* Counter footer */
    .kui-rte-counter { display: flex; justify-content: flex-end; gap: 0.75rem; padding: 0.375rem 0.75rem; border-top: 1px solid var(--border); background: var(--surface-overlay); color: var(--text-secondary); font-size: 0.75rem; }
    .kui-rte-counter.is-over { color: var(--error); }
    /* Skeleton */
    .kui-rte-skel { position: absolute; inset: 0; padding: 1rem; background: var(--surface-base); display: flex; flex-direction: column; gap: 0.5rem; }
    .kui-rte-skel span { height: 0.75rem; border-radius: 0.25rem; background: var(--surface-sunken); animation: kuiRtePulse 1.4s ease-in-out infinite; }
    @keyframes kuiRtePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    /* Fullscreen */
    .kui-rte-fullscreen { position: fixed !important; inset: 0 !important; z-index: 60 !important; background: var(--surface-base); border: 0 !important; border-radius: 0 !important; display: flex !important; flex-direction: column; max-width: none !important; max-height: none !important; width: 100vw !important; height: 100vh !important; }
    .kui-rte-fullscreen > .ql-toolbar { flex-shrink: 0; }
    .kui-rte-fullscreen > .relative { flex: 1; min-height: 0; display: flex; flex-direction: column; }
    .kui-rte-fullscreen > .relative > .kui-rte-content,
    .kui-rte-fullscreen > .relative > textarea { flex: 1 !important; min-height: 0 !important; height: auto !important; }
    .kui-rte-fullscreen > .kui-rte-counter { flex-shrink: 0; }
    /* Color & highlight popovers */
    .kui-rte-swatches { position: absolute; top: 100%; left: 0; margin-top: 0.25rem; padding: 0.375rem; display: flex; gap: 0.25rem; background: var(--surface-raised); border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 4px 12px rgb(0 0 0 / 0.08); z-index: 50; }
    .kui-rte-swatches button { width: 1.25rem; height: 1.25rem; border-radius: 2px; border: 1px solid var(--border); cursor: pointer; padding: 0; }
  </style>
  <script>
    try {
      var t = localStorage.getItem('theme') || 'system';
      if (t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
      if (localStorage.getItem('sidebar-collapsed') === 'true') {
        document.documentElement.classList.add('sidebar-collapsed');
      }
    } catch(e) {}
  </script>
</head>

<body class="bg-surface-base text-text-primary overflow-hidden">
<div class="flex h-screen overflow-hidden bg-surface-base">

  <%- include('./partials/sidebar') %>

  <div class="flex flex-1 flex-col min-w-0 min-h-0">
    <%- include('./partials/topbar') %>

    <main id="main-content" class="flex-1 overflow-y-auto p-4 sm:p-6">

      <% if (!selected && selectedId === null) { %>
        <%- include('./partials/home-panel') %>

      <% } else if (!selected) { %>
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <i class="fa-solid fa-house text-4xl text-text-disabled mb-4" aria-hidden="true"></i>
          <h2 class="text-xl font-semibold text-text-primary mb-1">Showcase coming soon</h2>
          <p class="text-sm text-text-secondary">No preview has been added for this component yet.</p>
        </div>

      <% } else { %>
        <div class="mb-2">
          <div class="flex flex-wrap items-center gap-3 mb-1">
            <h2 class="text-2xl font-bold text-text-primary leading-tight"><%= selected.title %></h2>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium"
              style="<%= catStyle[selected.category] || 'background:var(--surface-sunken);color:var(--text-secondary)' %>"
            ><%= selected.category %></span>
            <% if (selected.external) { %>
              <%- include('./partials/external-links-popover', { external: selected.external, title: selected.title }) %>
            <% } %>
          </div>
          <p class="text-sm text-text-secondary max-w-2xl"><%= selected.description %></p>
        </div>

        <%
          var _gridClass = locals.variantLayout === 'grid'
            ? 'grid-cols-1 xl:grid-cols-2'
            : 'grid-cols-1';
        %>
        <div class="grid <%= _gridClass %> gap-4">
          <% selected.variants.forEach(function(variant) {
            var _spanClass = (locals.variantLayout === 'grid' && variant.layout === 'stack') ? 'xl:col-span-2' : '';
          %>
            <div class="<%= _spanClass %>">
              <%- include('./partials/widget', { variant: variant, variantLayout: locals.variantLayout }) %>
            </div>
          <% }); %>
        </div>

        <%- include('./partials/source-block') %>
      <% } %>

    </main>
  </div>

</div>
<script src="/assets/js/showcase.js"></script>
</body>
</html>
