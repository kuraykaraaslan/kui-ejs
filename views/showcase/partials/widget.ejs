<%
  // Effective layout: global 'side' or 'stack' overrides per-variant.layout.
  // In 'grid' global mode, per-variant.layout still decides direction.
  var _global = locals.variantLayout || 'side';
  var _isStack = (_global === 'side' || _global === 'stack')
    ? _global === 'stack'
    : variant.layout === 'stack';
%>
<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <div class="flex flex-col">
  <!-- Header -->
  <div class="widget-drag-handle flex items-center justify-between gap-3 px-4 py-3 border-b border-border bg-surface-overlay shrink-0">
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-text-disabled text-xs shrink-0 select-none leading-none" aria-hidden="true">⠿</span>
      <h3 class="text-sm font-semibold text-text-primary truncate"><%= variant.title %></h3>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        aria-label="Copy code"
        class="copy-btn px-2.5 py-1 text-xs rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus bg-surface-overlay text-text-secondary hover:text-text-primary hover:bg-surface-sunken"
        data-code="<%- encodeURIComponent(variant.code) %>"
      >Copy</button>
    </div>
  </div>

  <div class="flex-1 min-h-0">
  <!-- Preview + Code -->
  <div class="flex divide-border <%= _isStack ? 'flex-col divide-y' : 'flex-col sm:flex-row divide-y sm:divide-y-0 sm:divide-x' %>">

    <!-- Preview panel -->
    <div class="flex flex-col <%= !_isStack ? 'sm:w-2/5' : '' %>">
      <div class="px-3 py-1.5 border-b border-border bg-surface-overlay">
        <span class="text-xs font-medium text-text-secondary uppercase tracking-wider">Preview</span>
      </div>
      <div
        class="flex items-start justify-center px-6 py-8 <%= _isStack ? 'min-h-40' : 'flex-1 min-h-28' %>"
        style="background-image:radial-gradient(circle,var(--border) 1px,transparent 1px);background-size:16px 16px"
      >
        <div class="w-full <%= !_isStack ? 'flex flex-wrap gap-2 items-center justify-center' : '' %>">
          <%- variant.previewHtml %>
        </div>
      </div>
    </div>

    <!-- Code panel -->
    <div class="flex flex-col bg-surface-sunken overflow-x-auto <%= !_isStack ? 'flex-1' : '' %>">
      <div class="px-3 py-1.5 border-b border-border bg-surface-overlay">
        <span class="text-xs font-medium text-text-secondary uppercase tracking-wider">Code</span>
      </div>
      <pre class="flex-1 px-4 py-5 text-sm font-mono text-text-primary leading-relaxed whitespace-pre-wrap"><code><%- variant.code %></code></pre>
    </div>

  </div>
  </div>
  </div>
</div>
