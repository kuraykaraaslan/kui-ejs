<%
  // Effective layout: global 'side' or 'stack' overrides per-variant.layout.
  // In 'grid' global mode, per-variant.layout still decides direction.
  var _global = locals.variantLayout || 'side';
  var _isStack = (_global === 'side' || _global === 'stack')
    ? _global === 'stack'
    : variant.layout === 'stack';
  var _hasCode = !!variant.code;
  var _previewCls = variant.previewClassName || '';
  var _previewInnerCls = variant.previewInnerClassName || '';
%>
<div class="variant-block bg-surface-raised border border-border rounded-xl overflow-hidden flex flex-col" data-variant-block>
  <!-- Header -->
  <div class="widget-drag-handle flex items-center justify-between gap-3 px-4 py-3 border-b border-border bg-surface-overlay shrink-0">
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-text-disabled text-xs shrink-0 select-none leading-none" aria-hidden="true">⠿</span>
      <h3 class="text-sm font-semibold text-text-primary truncate"><%= variant.title %></h3>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <% if (_hasCode) { %>
      <button
        type="button"
        aria-label="Copy code"
        class="copy-btn px-2.5 py-1 text-xs rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus bg-surface-overlay text-text-secondary hover:text-text-primary hover:bg-surface-sunken"
        data-code="<%- encodeURIComponent(variant.code) %>"
      >Copy</button>
      <% } %>
      <button
        type="button"
        aria-label="Enter fullscreen"
        aria-pressed="false"
        title="Enter fullscreen"
        class="variant-fullscreen-btn px-2.5 py-1 text-xs rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus bg-surface-overlay text-text-secondary hover:text-text-primary hover:bg-surface-sunken inline-flex items-center justify-center"
        data-fullscreen-btn
      ><i class="fa-solid fa-expand" aria-hidden="true" data-fullscreen-icon></i></button>
    </div>
  </div>

  <div class="flex-1 min-h-0">
  <!-- Preview + Code -->
  <div
    class="variant-split flex <%= _isStack ? 'flex-col' : 'flex-col sm:flex-row' %>"
    data-variant-split
    data-stack="<%= _isStack ? '1' : '0' %>"
  >

    <!-- Preview panel -->
    <div
      class="flex flex-col <%= (_hasCode && !_isStack) ? 'border-b border-border sm:border-b-0' : '' %> <%= !_hasCode ? 'w-full' : '' %>"
      data-split-preview
    >
      <div class="px-3 py-1.5 border-b border-border bg-surface-overlay">
        <span class="text-xs font-medium text-text-secondary uppercase tracking-wider">Preview</span>
      </div>
      <div
        class="flex items-start justify-center px-6 py-8 <%= _isStack ? 'min-h-40' : 'flex-1 min-h-28' %> <%= _previewCls %>"
        style="background-image:radial-gradient(circle,var(--border) 1px,transparent 1px);background-size:16px 16px"
      >
        <div class="w-full <%= !_isStack ? 'flex flex-wrap gap-2 items-center justify-center' : '' %> <%= _previewInnerCls %>">
          <%- variant.previewHtml %>
        </div>
      </div>
    </div>

    <% if (_hasCode && !_isStack) { %>
    <!-- Resizer -->
    <div
      class="hidden sm:flex relative shrink-0 w-1.5 group cursor-col-resize touch-none select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus"
      role="separator"
      aria-orientation="vertical"
      aria-label="Resize preview and code panes"
      aria-valuemin="20"
      aria-valuemax="80"
      aria-valuenow="40"
      tabindex="0"
      title="Drag to resize · Double-click to reset"
      data-split-resizer
    >
      <span aria-hidden="true" class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-border group-hover:bg-border-focus group-active:bg-border-focus transition-colors"></span>
      <span aria-hidden="true" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-8 w-1 rounded-full bg-border-strong opacity-0 group-hover:opacity-100 group-active:opacity-100 transition-opacity"></span>
    </div>
    <% } %>

    <% if (_hasCode) { %>
    <!-- Code panel -->
    <div
      class="flex flex-col bg-surface-sunken overflow-x-auto <%= !_isStack ? 'flex-1 min-w-0' : '' %>"
      data-split-code
    >
      <div class="px-3 py-1.5 border-b border-border bg-surface-overlay">
        <span class="text-xs font-medium text-text-secondary uppercase tracking-wider">Code</span>
      </div>
      <pre class="flex-1 px-4 py-5 text-sm font-mono text-text-primary leading-relaxed whitespace-pre-wrap"><code><%- variant.code %></code></pre>
    </div>
    <% } %>

  </div>
  </div>
</div>
