# ---------------------------------------------------------------------------
# AvantLeap / ALejs theme preset
# ---------------------------------------------------------------------------
# Activate by copying to .env.local and restarting the dev server:
#   cp .env.avantleap .env.local
#
# Palette:
#   #ffc51b — accent yellow  (primary)
#   #1d232a — dark surface   (raised in dark mode)
#   #191e24 — deepest dark   (base in dark mode)

# --- Brand ---------------------------------------------------------------
BRAND_SHORT="AL-ejs"
BRAND_NAME="ALejs"
BRAND_INITIAL="A"
BRAND_TAGLINE="Composable UI System by AvantLeap"
BRAND_DESCRIPTION="ALejs is AvantLeap's production-ready UI system built with Express and EJS. A composable design system and component architecture for real-world applications."

# --- Links ---------------------------------------------------------------
SITE_URL="https://avantleap.com"
GITHUB_URL="https://github.com/avantleap"
TWITTER_HANDLE="@avantleap"
AUTHOR_NAME="AvantLeap"
AUTHOR_URL="https://avantleap.com"

# --- Colors (light mode) -------------------------------------------------
COLOR_PRIMARY="#ffc51b"
COLOR_PRIMARY_HOVER="#e6b117"
COLOR_PRIMARY_ACTIVE="#cc9d14"
COLOR_PRIMARY_SUBTLE="#fff5cc"
COLOR_PRIMARY_FG="#1d232a"

COLOR_SECONDARY="#1d232a"
COLOR_SECONDARY_HOVER="#2a3340"
COLOR_SECONDARY_ACTIVE="#191e24"
COLOR_SECONDARY_SUBTLE="#eef0f2"
COLOR_SECONDARY_FG="#ffffff"

COLOR_BORDER_FOCUS="#ffc51b"

# --- Colors (dark mode) --------------------------------------------------
COLOR_PRIMARY_DARK="#ffc51b"
COLOR_PRIMARY_HOVER_DARK="#ffd24d"
COLOR_PRIMARY_ACTIVE_DARK="#e6b117"
COLOR_PRIMARY_SUBTLE_DARK="#3a2d05"
COLOR_PRIMARY_FG_DARK="#1d232a"

COLOR_SECONDARY_DARK="#ffc51b"
COLOR_SECONDARY_HOVER_DARK="#ffd24d"
COLOR_SECONDARY_ACTIVE_DARK="#e6b117"
COLOR_SECONDARY_SUBTLE_DARK="#3a2d05"
COLOR_SECONDARY_FG_DARK="#1d232a"

COLOR_SURFACE_BASE_DARK="#191e24"
COLOR_SURFACE_RAISED_DARK="#1d232a"
COLOR_SURFACE_OVERLAY_DARK="#262d36"
COLOR_SURFACE_SUNKEN_DARK="#13171c"

COLOR_BORDER_DARK="#262d36"
COLOR_BORDER_STRONG_DARK="#3a4350"
COLOR_BORDER_FOCUS_DARK="#ffc51b"
