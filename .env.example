# ---------------------------------------------------------------------------
# Showcase overrides
# ---------------------------------------------------------------------------
# All variables are optional. Each one falls back to the built-in default
# (the same values the showcase ships with) when left unset, so this file
# is purely a reference of what can be customised.
#
# Loaded automatically at server boot by `dotenv` from .env.local.
# Restart the dev server after changing values.

# --- Brand ---------------------------------------------------------------
BRAND_SHORT="KUI-ejs"
BRAND_NAME="KUIejs"
BRAND_INITIAL="K"
BRAND_TAGLINE="Composable UI System for Real Products"
BRAND_DESCRIPTION="KUIejs is a production-ready UI system built with Express and EJS. A composable design system and component architecture for real-world applications."
BRAND_KEYWORDS="EJS UI components, Express design system, component library, UI kit, frontend system, design system, EJS UI"

# --- Links ---------------------------------------------------------------
SITE_URL="https://ejs-components.kuray.dev"
GITHUB_URL="https://github.com/kuraykaraaslan/KUIejs"
TWITTER_HANDLE="@kuraykaraaslan"
AUTHOR_NAME="Kuray Karaaslan"
AUTHOR_URL="https://kuray.dev"

# --- Colors (light mode) -------------------------------------------------
# Any value left unset keeps the default from public/assets/css/input.css.
# Values are injected as CSS variables on :root after app.css, so they
# override the defaults without editing CSS.
# COLOR_PRIMARY="#8b5cf6"
# COLOR_PRIMARY_HOVER="#7c3aed"
# COLOR_PRIMARY_ACTIVE="#6d28d9"
# COLOR_PRIMARY_SUBTLE="#f5f3ff"
# COLOR_PRIMARY_FG="#ffffff"
# COLOR_SECONDARY="#3b82f6"
# COLOR_SECONDARY_HOVER="#2563eb"
# COLOR_SECONDARY_ACTIVE="#1d4ed8"
# COLOR_SECONDARY_SUBTLE="#eff6ff"
# COLOR_SECONDARY_FG="#ffffff"
# COLOR_SURFACE_BASE="#ffffff"
# COLOR_SURFACE_RAISED="#f9fafb"
# COLOR_SURFACE_OVERLAY="#f3f4f6"
# COLOR_SURFACE_SUNKEN="#e5e7eb"
# COLOR_BORDER="#e5e7eb"
# COLOR_BORDER_STRONG="#d1d5db"
# COLOR_BORDER_FOCUS="#8b5cf6"

