# ---------------------------------------------------------------------------
# Roltek / ROejs theme preset
# ---------------------------------------------------------------------------
# Activate by copying to .env.local and restarting the dev server:
#   cp .env.roltek .env.local
#
# Palette:
#   #86bc3c — leaf green  (primary)
#   #24a0d3 — sky blue    (secondary)

# --- Brand ---------------------------------------------------------------
BRAND_SHORT="RO-ejs"
BRAND_NAME="ROejs"
BRAND_INITIAL="R"
BRAND_TAGLINE="Composable UI System by Roltek"
BRAND_DESCRIPTION="ROejs is Roltek's production-ready UI system built with Express and EJS. A composable design system and component architecture for real-world applications."

# --- Links ---------------------------------------------------------------
SITE_URL="https://roltek.com.tr"
GITHUB_URL="https://github.com/roltek"
TWITTER_HANDLE="@roltek"
AUTHOR_NAME="Roltek"
AUTHOR_URL="https://roltek.com.tr"

# --- Colors (light mode) -------------------------------------------------
COLOR_PRIMARY="#86bc3c"
COLOR_PRIMARY_HOVER="#76a635"
COLOR_PRIMARY_ACTIVE="#66902d"
COLOR_PRIMARY_SUBTLE="#f0f8e3"
COLOR_PRIMARY_FG="#ffffff"

COLOR_SECONDARY="#24a0d3"
COLOR_SECONDARY_HOVER="#1c8aba"
COLOR_SECONDARY_ACTIVE="#1574a0"
COLOR_SECONDARY_SUBTLE="#e3f2fa"
COLOR_SECONDARY_FG="#ffffff"

COLOR_BORDER_FOCUS="#86bc3c"

# --- Colors (dark mode) --------------------------------------------------
COLOR_PRIMARY_DARK="#9bd14b"
COLOR_PRIMARY_HOVER_DARK="#aedc6a"
COLOR_PRIMARY_ACTIVE_DARK="#86bc3c"
COLOR_PRIMARY_SUBTLE_DARK="#1f3a0e"
COLOR_PRIMARY_FG_DARK="#0c1410"

COLOR_SECONDARY_DARK="#4ab8e3"
COLOR_SECONDARY_HOVER_DARK="#6cc5e8"
COLOR_SECONDARY_ACTIVE_DARK="#24a0d3"
COLOR_SECONDARY_SUBTLE_DARK="#0a2a3a"
COLOR_SECONDARY_FG_DARK="#ffffff"

COLOR_BORDER_FOCUS_DARK="#9bd14b"
