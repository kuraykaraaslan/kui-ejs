  // Server-side twin of scripts/time-window-logic.js (kui-react TimeWindowSelect.tsx helpers).
  // Fills the object passed as `L`:  include('./TimeWindowSelect/_logic', { L: L })
  // Keep in step with scripts/time-window-logic.js; tests/time-window-select.test.ts
  // checks both agree over a table of inputs.
  var L = locals.L;
  L.DURATION = /^([1-9]\d{0,5})([mhd])$/;
  L.UNIT_MS = { m: 60000, h: 3600000, d: 86400000 };
  var PERIOD_UNIT_MS = {
    hour: 3600000, day: 86400000, week: 7 * 86400000, isoWeek: 7 * 86400000, month: 30 * 86400000,
    quarter: 91 * 86400000, halfYear: 182 * 86400000, year: 365 * 86400000,
  };
  function wallParts(t, timeZone) {
    var opts = { hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    if (timeZone) opts.timeZone = timeZone;
    var p = {};
    new Intl.DateTimeFormat('en-CA', opts).formatToParts(new Date(t)).forEach(function (part) { p[part.type] = part.value; });
    return p;
  }
  L.toZonedInput = function (iso, timeZone) {
    var p = wallParts(Date.parse(iso), timeZone);
    return p.year + '-' + p.month + '-' + p.day + 'T' + p.hour + ':' + p.minute;
  };
  L.windowSpanMs = function (w) {
    if (w.mode === 'relative') {
      var m = L.DURATION.exec(w.last);
      return m ? Number(m[1]) * L.UNIT_MS[m[2]] : null;
    }
    if (w.mode === 'absolute') {
      var s = Date.parse(w.to) - Date.parse(w.from);
      return isFinite(s) && s > 0 ? s : null;
    }
    if (w.period === 'dayBeforeYesterday' || w.period === 'thisDayLastWeek') return 86400000;
    var unit = PERIOD_UNIT_MS[String(w.period).split('.')[1]];
    return unit != null ? unit : null;
  };
  L.intervalMs = function (i) {
    var m = /^([1-9]\d*)([mhd])$/.exec(i);
    return m ? Number(m[1]) * L.UNIT_MS[m[2]] : null;
  };
  L.isCurrent = function (p) { return String(p).indexOf('current.') === 0; };
  L.tabOf = function (w) {
    return !w || w.mode === 'relative' || (w.mode === 'calendar' && L.isCurrent(w.period)) ? 'realtime' : 'history';
  };
  L.summarize = function (w, m) {
    if (!w) return m.label;
    var tab = L.tabOf(w) === 'realtime' ? m.realtime : m.history;
    var periods = m.periods || {};
    var what = w.mode === 'relative'
      ? m.last + ' ' + w.last
      : w.mode === 'calendar'
        ? (periods[w.period] != null ? periods[w.period] : w.period) + (w.soFar ? ' (' + m.soFar.toLowerCase() + ')' : '')
        : L.toZonedInput(w.from, w.timezone).replace('T', ' ') + ' – ' + L.toZonedInput(w.to, w.timezone).replace('T', ' ');
