    var iv = w.interval && w.interval !== 'auto' ? w.interval : null;
    if (w.aggregation || iv) parts.push([w.aggregation, iv].filter(Boolean).join(' '));
    if (w.timezone) parts.push(w.timezone);
    return parts.join(' · ');
  };
