<%
  // Legacy AdvancedDataTable surface — preserved verbatim for backwards
  // compatibility. M4 will fold this into the unified `<DataTable />` with
  // `selectable`/`expandable` props.
  var _columns       = locals.columns       || [];
  var _rows          = locals.rows          || [];
  var _caption       = locals.caption       || '';
  var _selectable    = !!locals.selectable;
  var _stickyHeader  = !!locals.stickyHeader;
  var _emptyMessage  = locals.emptyMessage  || 'No results found.';
  var _className     = locals.className     || '';
  var _id            = locals.id            || 'adt-' + Math.random().toString(36).substr(2, 9);

  var _hasExpand = false;
  for (var _ri = 0; _ri < _rows.length; _ri++) {
    if (_rows[_ri] && _rows[_ri]._expanded !== undefined && _rows[_ri]._expanded !== null && _rows[_ri]._expanded !== '') {
      _hasExpand = true; break;
    }
  }
  var _totalCols = _columns.length + (_selectable ? 1 : 0) + (_hasExpand ? 1 : 0);
  var _alignClass = { left: 'text-left', center: 'text-center', right: 'text-right' };
%>
<div id="<%= _id %>" class="space-y-2<%= _className ? ' ' + _className : '' %>" data-adt-root>
  <% if (_selectable) { %>
  <p class="text-xs text-text-secondary hidden" data-adt-count>
    <span data-adt-count-num>0</span> of <%= _rows.length %> row<%= _rows.length !== 1 ? 's' : '' %> selected
  </p>
  <% } %>
  <div class="w-full rounded-lg border border-border<%= _stickyHeader ? ' overflow-auto max-h-80' : '' %>">
    <table class="w-full text-sm">
      <% if (_caption) { %><caption class="sr-only"><%= _caption %></caption><% } %>
      <thead class="bg-surface-sunken border-b border-border<%= _stickyHeader ? ' sticky top-0 z-10' : '' %>">
        <tr>
          <% if (_selectable) { %>
          <th scope="col" class="w-10 px-4 py-3">
            <input
              type="checkbox"
              aria-label="Select all rows"
              data-adt-select-all
              class="h-4 w-4 rounded border-border text-primary focus-visible:ring-2 focus-visible:ring-border-focus"
            />
          </th>
          <% } %>
          <% if (_hasExpand) { %>
          <th scope="col" class="w-10 px-4 py-3" aria-label="Expand"></th>
          <% } %>
          <% _columns.forEach(function(col) { %>
          <th scope="col" class="px-4 py-3 text-xs font-semibold text-text-secondary uppercase tracking-wider <%= _alignClass[col.align] || 'text-left' %><%= col.thClass ? ' ' + col.thClass : '' %>">
            <%= col.header %>
          </th>
          <% }); %>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-surface-base">
        <% if (_rows.length === 0) { %>
        <tr>
          <td colspan="<%= _totalCols %>" class="px-4 py-10 text-center text-sm text-text-secondary">
            <%= _emptyMessage %>
          </td>
        </tr>
        <% } else { %>
          <% _rows.forEach(function(row, i) {
            var _rowHasExpand = row._expanded !== undefined && row._expanded !== null && row._expanded !== '';
          %>
          <tr class="hover:bg-surface-overlay transition-colors" data-adt-row="<%= i %>">
            <% if (_selectable) { %>
            <td class="w-10 px-4 py-3">
              <input
                type="checkbox"
                aria-label="Select row <%= i + 1 %>"
                data-adt-row-check="<%= i %>"
                class="h-4 w-4 rounded border-border text-primary focus-visible:ring-2 focus-visible:ring-border-focus"
              />
            </td>
            <% } %>
            <% if (_hasExpand && _rowHasExpand) { %>
            <td class="w-10 px-4 py-3">
              <button
                type="button"
                aria-label="Expand row"
                aria-expanded="false"
                data-adt-expand="<%= i %>"
                class="text-text-disabled hover:text-text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus rounded"
              >
                <span class="w-2.5 h-2.5 inline-flex items-center justify-center" aria-hidden="true">
                  <i class="fa-solid fa-chevron-right" data-adt-expand-icon style="font-size:10px"></i>
                </span>
              </button>
            </td>
            <% } else if (_hasExpand) { %>
            <td class="w-10 px-4 py-3"></td>
            <% } %>
            <% _columns.forEach(function(col) { %>
            <td class="px-4 py-3 text-text-primary<%= col.align ? ' ' + (_alignClass[col.align] || '') : '' %><%= col.tdClass ? ' ' + col.tdClass : '' %>">
              <% if (col.render) { %>
                <%- col.render(row) %>
              <% } else { %>
                <%= row[col.key] !== undefined && row[col.key] !== null ? row[col.key] : '' %>
              <% } %>
            </td>
            <% }); %>
          </tr>
          <% if (_rowHasExpand) { %>
          <tr class="bg-surface-sunken hidden" data-adt-expanded="<%= i %>">
            <td colspan="<%= _totalCols %>" class="px-6 py-3 text-sm text-text-secondary">
              <%- row._expanded %>
            </td>
          </tr>
          <% } %>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('<%= _id %>');
  if (!root) return;
  var selectable = <%= _selectable ? 'true' : 'false' %>;
  var totalRows  = <%= _rows.length %>;

  // Expand/collapse
  root.querySelectorAll('[data-adt-expand]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var i = btn.getAttribute('data-adt-expand');
      var row = root.querySelector('[data-adt-expanded="' + i + '"]');
      if (!row) return;
      var expanded = !row.classList.contains('hidden') ? false : true;
      if (expanded) {
        row.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Collapse row');
        var icon = btn.querySelector('[data-adt-expand-icon]');
        if (icon) { icon.classList.remove('fa-chevron-right'); icon.classList.add('fa-chevron-down'); }
      } else {
        row.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Expand row');
        var icon2 = btn.querySelector('[data-adt-expand-icon]');
        if (icon2) { icon2.classList.remove('fa-chevron-down'); icon2.classList.add('fa-chevron-right'); }
      }
    });
  });

  if (!selectable) return;

  var selectAll = root.querySelector('[data-adt-select-all]');
  var rowChecks = root.querySelectorAll('[data-adt-row-check]');
  var countEl   = root.querySelector('[data-adt-count]');
  var countNum  = root.querySelector('[data-adt-count-num]');

  function refresh() {
    var count = 0;
    rowChecks.forEach(function (c) { if (c.checked) count++; });
    if (countNum) countNum.textContent = String(count);
    if (countEl)  countEl.classList.toggle('hidden', count === 0);
    rowChecks.forEach(function (c) {
      var tr = c.closest('tr');
      if (!tr) return;
      if (c.checked) tr.classList.add('bg-primary-subtle');
      else tr.classList.remove('bg-primary-subtle');
    });
    if (selectAll) {
      if (count === 0)           { selectAll.checked = false; selectAll.indeterminate = false; }
      else if (count === totalRows) { selectAll.checked = true;  selectAll.indeterminate = false; }
      else                       { selectAll.checked = false; selectAll.indeterminate = true;  }
    }
    root.dispatchEvent(new CustomEvent('adt:selection', { detail: { count: count } }));
  }

  if (selectAll) {
    selectAll.addEventListener('change', function () {
      var on = selectAll.checked;
      rowChecks.forEach(function (c) { c.checked = on; });
      refresh();
    });
  }
  rowChecks.forEach(function (c) { c.addEventListener('change', refresh); });
  refresh();
})();
</script>
