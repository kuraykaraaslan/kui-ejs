<%
  // ControlSetpoint — type a number, press Apply or Enter. A bad entry is a field
  // error and sends nothing. Mirror of kui-react ControlSetpoint.
  //
  // Locals:
  //   id, title, value, reported, onCommit — as ControlSlider
  //   min (0), max (100), step (1), unit, decimals (0)
  //   readOnly, disabled, timeoutMs (10000), className, loadRuntime
  //   messages — the shared ones plus { apply: 'Apply', enterNumber: 'Enter a number.',
  //              outOfRange: 'Enter a value between {min} and {max}.', current: 'Current: {value}' }
  var L = {};
  include('./_logic', { L: L });
  var _id = locals.id || ('control-setpoint-' + Math.random().toString(36).substr(2, 9));
  var _range = L.toRange({ min: locals.min, max: locals.max, step: locals.step });
  var _bound = L.asNumber(locals.value);
  var _decimals = locals.decimals || 0;
  var _unit = locals.unit || '';
  var _readOnly = !!locals.readOnly;
  var _disabled = !!locals.disabled;
  var _msgs = Object.assign({
    apply: 'Apply', enterNumber: 'Enter a number.',
    outOfRange: 'Enter a value between {min} and {max}.', current: 'Current: {value}',
  }, locals.messages || {});
  function esc(t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  var _apply = include('../Button', { type: 'submit', children: _msgs.apply, disabled: _disabled || _readOnly });
  // The Button partial has no free attribute slot, so tag it for the runtime afterwards.
  _apply = _apply.replace('<button', '<button data-kui-control-apply');
  var body = '<form class="space-y-1" novalidate>'
    + '<div class="flex items-center gap-2">'
    + '<input inputmode="decimal" aria-label="' + esc(locals.title || 'Set point') + '" aria-invalid="false" data-kui-control-input'
    +   ' value="' + esc(_bound !== null ? String(_bound) : '') + '"' + ((_disabled || _readOnly) ? ' disabled' : '')
    +   ' class="h-9 w-28 rounded-md border border-border bg-surface-base px-2 text-sm tabular-nums text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus disabled:opacity-50">'
    + (_unit ? '<span class="text-sm text-text-secondary">' + esc(_unit) + '</span>' : '')
    + _apply
    + '</div>'
    + '<p class="text-xs text-text-secondary" data-kui-control-current' + (_bound === null ? ' hidden' : '') + '>'
    +   (_bound !== null ? esc(_msgs.current.replace('{value}', L.formatValue(_bound, _decimals) + (_unit ? ' ' + _unit : ''))) : '') + '</p>'
    + '<div data-kui-control-error-host></div>'
    + '</form>';
%>
<%- include('./ControlTile', {
  id: _id, title: locals.title, kind: 'setpoint', readOnly: _readOnly, messages: _msgs, className: locals.className, body: body,
  config: {
    value: locals.value, reported: locals.reported, timeoutMs: locals.timeoutMs, readOnly: _readOnly, disabled: _disabled,
    min: locals.min, max: locals.max, step: locals.step, unit: locals.unit, decimals: _decimals, onCommit: locals.onCommit,
  },
}) %>
<% if (locals.loadRuntime !== false) { %><%- include('./_runtime') %><% } %>
