<%
  var _slides           = locals.slides           || [];
  var _autoPlay         = !!locals.autoPlay;
  var _autoPlayInterval = Number(locals.autoPlayInterval) || 4000;
  var _showDots         = locals.showDots !== false;
  var _showArrows       = locals.showArrows !== false;
  var _loop             = locals.loop !== false;
  var _className        = locals.className        || '';
  var _slideClassName   = locals.slideClassName   || '';
  var _ariaLabel        = locals.ariaLabel        || 'Content slider';
  var _id               = locals.id               || 'slider-' + Math.random().toString(36).substr(2, 9);
  var _total            = _slides.length;
%>
<% if (_total > 0) { %>
<div
  id="<%= _id %>"
  class="relative overflow-hidden rounded-xl<%= _className ? ' ' + _className : '' %>"
  role="region"
  aria-label="<%= _ariaLabel %>"
  aria-roledescription="carousel"
  data-slider-total="<%= _total %>"
  data-slider-autoplay="<%= _autoPlay ? '1' : '0' %>"
  data-slider-interval="<%= _autoPlayInterval %>"
  data-slider-loop="<%= _loop ? '1' : '0' %>"
>
  <div
    class="flex ease-in-out will-change-transform"
    style="transform: translateX(0%); transition-property: transform; transition-duration: 350ms;"
    data-slider-track
  >
    <% _slides.forEach(function(slide, i) { %>
    <div
      role="group"
      aria-roledescription="slide"
      aria-label="Slide <%= i + 1 %> of <%= _total %>"
      aria-hidden="<%= i === 0 ? 'false' : 'true' %>"
      class="w-full shrink-0<%= _slideClassName ? ' ' + _slideClassName : '' %>"
      data-slider-slide="<%= i %>"
    >
      <%- slide %>
    </div>
    <% }); %>
  </div>

  <% if (_showArrows && _total > 1) { %>
  <button
    type="button"
    aria-label="Previous slide"
    data-slider-prev
    class="absolute left-3 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-black/40 hover:bg-black/60 text-white flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white<%= (!_loop && _total <= 1) ? ' hidden' : '' %>"
  >‹</button>
  <button
    type="button"
    aria-label="Next slide"
    data-slider-next
    class="absolute right-3 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-black/40 hover:bg-black/60 text-white flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
  >›</button>
  <% } %>

  <% if (_showDots && _total > 1) { %>
  <div
    class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10"
    role="tablist"
    aria-label="Slide indicators"
    data-slider-dots
  >
    <% for (var _di = 0; _di < _total; _di++) { %>
    <button
      type="button"
      role="tab"
      aria-selected="<%= _di === 0 ? 'true' : 'false' %>"
      aria-label="Go to slide <%= _di + 1 %>"
      data-slider-dot="<%= _di %>"
      class="<%= _di === 0 ? 'h-2 w-5 bg-white' : 'h-2 w-2 bg-white/40 hover:bg-white/70' %> rounded-full transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
    ></button>
    <% } %>
  </div>
  <% } %>
</div>

<script>
(function () {
  var root = document.getElementById('<%= _id %>');
  if (!root) return;
  var total    = parseInt(root.getAttribute('data-slider-total'), 10) || 0;
  var autoPlay = root.getAttribute('data-slider-autoplay') === '1';
  var interval = parseInt(root.getAttribute('data-slider-interval'), 10) || 4000;
  var loop     = root.getAttribute('data-slider-loop') === '1';
  if (total <= 1) return;

  var track    = root.querySelector('[data-slider-track]');
  var prevBtn  = root.querySelector('[data-slider-prev]');
  var nextBtn  = root.querySelector('[data-slider-next]');
  var dots     = Array.prototype.slice.call(root.querySelectorAll('[data-slider-dot]'));
  var slides   = Array.prototype.slice.call(root.querySelectorAll('[data-slider-slide]'));
  var current  = 0;
  var timer    = null;
  var transitioning = false;

  function render() {
    if (track) track.style.transform = 'translateX(-' + (current * 100) + '%)';
    slides.forEach(function (s, i) { s.setAttribute('aria-hidden', i === current ? 'false' : 'true'); });
    dots.forEach(function (d, i) {
      d.setAttribute('aria-selected', i === current ? 'true' : 'false');
      if (i === current) {
        d.classList.remove('w-2', 'bg-white/40', 'hover:bg-white/70');
        d.classList.add('w-5', 'bg-white');
      } else {
        d.classList.remove('w-5', 'bg-white');
        d.classList.add('w-2', 'bg-white/40', 'hover:bg-white/70');
      }
    });
    // Toggle prev/next visibility based on canPrev/canNext in non-loop mode
    var canPrev = loop || current > 0;
    var canNext = loop || current < total - 1;
    if (prevBtn) prevBtn.classList.toggle('hidden', !canPrev);
    if (nextBtn) nextBtn.classList.toggle('hidden', !canNext);
  }

  function goTo(idx) {
    if (transitioning || idx === current) return;
    transitioning = true;
    if (loop) current = ((idx % total) + total) % total;
    else current = Math.max(0, Math.min(idx, total - 1));
    render();
    setTimeout(function () { transitioning = false; }, 350);
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); });
  dots.forEach(function (d, i) { d.addEventListener('click', function () { goTo(i); }); });

  function start() {
    if (!autoPlay || timer) return;
    timer = setInterval(function () {
      var nxt = current + 1;
      if (!loop && nxt >= total) { stop(); return; }
      goTo(nxt);
    }, interval);
  }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }

  // Initial render to reflect canPrev/canNext on mount (e.g. non-loop slider)
  render();

  start();
})();
</script>
<% } %>
