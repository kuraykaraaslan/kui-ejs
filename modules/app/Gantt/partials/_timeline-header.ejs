<%
  // ── Timeline header partial ─────────────────────────────────────────
  // Locals: columns, totalWidth
  var columns = columns || [];
  var totalWidth = totalWidth;
%>
<div role="row" aria-rowindex="1"
  class="gantt-timeline-header flex h-12 shrink-0 border-b border-border bg-surface-raised"
  style="width: <%= totalWidth %>px;">
  <% columns.forEach(function (col, i) { %>
    <div role="columnheader"
      aria-colindex="<%= i + 1 %>"
      class="flex flex-col items-center justify-center shrink-0 border-r border-border text-text-secondary select-none"
      style="width: <%= col.width %>px;">
      <span class="text-xs font-semibold tabular-nums text-text-primary leading-tight"><%= col.label %></span>
      <% if (col.subLabel) { %>
        <span class="text-[10px] leading-tight"><%= col.subLabel %></span>
      <% } %>
    </div>
  <% }); %>
</div>
