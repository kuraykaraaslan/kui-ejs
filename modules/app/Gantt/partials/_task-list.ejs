<%
  // ── Task list (WBS) partial ─────────────────────────────────────────
  // Locals: _id, flatRows, _msg, ROW_HEIGHT, SIDE_PANEL_WIDTH, totalHeight, collapsedIds
  var _id = _id;
  var flatRows = flatRows || [];
  var _msg = _msg;
  var ROW_HEIGHT = ROW_HEIGHT;
  var SIDE_PANEL_WIDTH = SIDE_PANEL_WIDTH;
  var totalHeight = totalHeight;
  var collapsedIds = collapsedIds || {};
%>
<div class="gantt-task-side shrink-0 border-r border-border bg-surface-base" style="width: <%= SIDE_PANEL_WIDTH %>px;">
  <!-- Column header — must be h-12 (48px) to align with the timeline header -->
  <div role="row" aria-rowindex="1" class="flex h-12 items-center px-3 border-b border-border bg-surface-raised text-xs font-semibold text-text-secondary uppercase tracking-wide">
    <span class="flex-1 truncate"><%= _msg.taskColumn %></span>
    <span class="w-24 truncate"><%= _msg.ownerColumn %></span>
    <span class="w-10 text-right tabular-nums"><%= _msg.progressColumn %></span>
  </div>
  <div style="min-height: <%= totalHeight %>px;">
    <% flatRows.forEach(function (row, i) {
         var task = row.task;
         var depth = row.depth;
         var hasChildren = row.hasChildren;
         var isCollapsed = !!collapsedIds[task.id];
         var progress = Math.max(0, Math.min(100, task.progress || 0));
         var nameCls = task.isGroup ? 'font-semibold text-text-primary' : 'text-text-primary';
    %>
      <div role="row" aria-rowindex="<%= i + 2 %>"
        data-task-id="<%= task.id %>"
        class="flex items-center px-3 border-b border-border/60 text-sm hover:bg-surface-overlay transition-colors"
        style="height: <%= ROW_HEIGHT %>px;">
        <div class="flex items-center flex-1 min-w-0" style="padding-left: <%= depth * 16 %>px;">
          <% if (hasChildren) { %>
            <button type="button"
              data-kui-gantt-toggle="<%= task.id %>"
              aria-expanded="<%= isCollapsed ? 'false' : 'true' %>"
              aria-label="<%= (isCollapsed ? 'Expand ' : 'Collapse ') + task.name %>"
              class="inline-flex items-center justify-center w-5 h-5 mr-1 rounded text-text-secondary hover:text-text-primary hover:bg-surface-overlay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus">
              <i class="fa-solid <%= isCollapsed ? 'fa-chevron-right' : 'fa-chevron-down' %> w-3 h-3" aria-hidden="true" style="font-size:0.75rem"></i>
            </button>
          <% } else { %>
            <span aria-hidden="true" class="inline-block w-5 mr-1"></span>
          <% } %>
          <% if (task.isMilestone) { %>
            <%# TODO M4: replace with rotated diamond glyph %>
            <i class="fa-solid fa-calendar w-3 h-3 mr-1.5 text-text-secondary" aria-hidden="true" style="font-size:0.75rem"></i>
          <% } %>
          <span class="truncate <%= nameCls %>" title="<%= task.name %>"><%= task.name %></span>
        </div>
        <span class="w-24 truncate text-xs text-text-secondary" title="<%= task.owner || '' %>"><%= task.owner || '—' %></span>
        <span class="w-10 text-right text-xs tabular-nums text-text-secondary"><%= progress %>%</span>
      </div>
    <% }); %>
  </div>
</div>
