<%
  // ── Task bar partial ────────────────────────────────────────────────
  // Locals: task, left, width, top, height, progress
  var task = task;
  var ariaLabel = task.name + ': ' + new Date(task.start).toDateString() + ' to ' + new Date(task.end).toDateString() + ', ' + progress + '% complete';
%>
<div role="gridcell"
  aria-label="<%= ariaLabel %>"
  data-task-id="<%= task.id %>"
  class="gantt-task-bar absolute rounded-md overflow-hidden bg-primary-subtle border border-primary/40 shadow-sm select-none"
  style="left: <%= left %>px; width: <%= width %>px; top: <%= top %>px; height: <%= height %>px;">
  <div aria-hidden="true" class="absolute inset-y-0 left-0 bg-primary" style="width: <%= progress %>%;"></div>
  <div class="relative h-full flex items-center px-2 text-[11px] font-medium text-text-primary truncate">
    <span class="truncate"><%= task.name %></span>
    <span class="ml-auto pl-2 tabular-nums text-text-secondary"><%= progress %>%</span>
  </div>
  <%# TODO M2: resize handles + drag handle + progress thumb. %>
</div>
