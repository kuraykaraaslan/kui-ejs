<%
  // Agenda view — parallel of views/AgendaView.tsx (M5)
  // Locals: _id, _events, _today, _L, _windowStart, _windowEnd,
  //         _isSameDay, _fmtTime, _dotCls
  var COLOR_DOT = {
    primary:'bg-primary', success:'bg-success', warning:'bg-warning',
    error:'bg-error', info:'bg-info', secondary:'bg-secondary', neutral:'bg-text-secondary'
  };
  function dotCls(c) { return COLOR_DOT[c || 'primary'] || COLOR_DOT.primary; }

  function startOfDay(d) { var x = new Date(d); x.setHours(0,0,0,0); return x; }

  // Bucket events in the visible window by start-of-day, then sort.
  var winStart = _windowStart.getTime(), winEnd = _windowEnd.getTime();
  var byKey = {};
  for (var i = 0; i < _events.length; i++) {
    var e = _events[i];
    if (e.end.getTime() < winStart || e.start.getTime() > winEnd) continue;
    var key = startOfDay(e.start).getTime();
    if (!byKey[key]) byKey[key] = { date: new Date(key), events: [] };
    byKey[key].events.push(e);
  }
  var keys = Object.keys(byKey).sort(function (a, b) { return Number(a) - Number(b); });
  for (var k = 0; k < keys.length; k++) {
    byKey[keys[k]].events.sort(function (a, b) { return a.start.getTime() - b.start.getTime(); });
  }
%>
<div role="region" aria-label="<%= _L.messages.agenda %>" data-cal-agenda data-cal-id="<%= _id %>" class="flex flex-col w-full">
  <div class="flex items-center gap-2 px-3 py-2 border-b border-border bg-surface-base">
    <div class="relative flex-1">
      <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 w-3 h-3 text-text-secondary" aria-hidden="true" style="font-size:0.75rem"></i>
      <input
        type="search"
        data-cal-agenda-search
        placeholder="<%= _L.messages.search %>"
        aria-label="<%= _L.messages.search %>"
        class="w-full pl-8 pr-8 py-1.5 text-xs rounded-md border border-border bg-surface-base text-text-primary placeholder:text-text-disabled focus:outline-none focus-visible:ring-2 focus-visible:ring-border-focus"
      />
    </div>
  </div>

  <div class="flex-1 overflow-y-auto max-h-[60vh]">
    <% if (keys.length === 0) { %>
      <div class="flex items-center justify-center py-16 text-xs text-text-secondary"><%= _L.messages.noEvents %></div>
    <% } else { %>
      <% keys.forEach(function (key) {
           var b = byKey[key];
           var isToday = _isSameDay(b.date, _today);
           var chipCls = 'inline-flex items-center justify-center min-w-6 h-6 px-1.5 rounded-full text-xs font-semibold tabular-nums '
                       + (isToday ? 'bg-primary text-primary-fg' : 'bg-surface-overlay text-text-primary');
      %>
        <section data-cal-agenda-section class="border-b border-border last:border-b-0">
          <header class="flex items-baseline gap-2 px-3 py-2 bg-surface-raised border-b border-border">
            <span class="<%= chipCls %>"><%= b.date.getDate() %></span>
            <span class="text-xs font-semibold text-text-primary"><%= _L.dayLong[b.date.getDay()] %></span>
            <span class="text-[11px] text-text-secondary tabular-nums"><%= _L.monthNames[b.date.getMonth()] %> <%= b.date.getFullYear() %></span>
          </header>
          <ul class="flex flex-col">
            <% b.events.forEach(function (e) { %>
              <li>
                <button type="button"
                  data-event-id="<%= e.id %>"
                  data-event-title="<%= e.title %>"
                  data-event-start="<%= e.start.getTime() %>"
                  data-event-end="<%= e.end.getTime() %>"
                  data-event-color="<%= e.color || 'primary' %>"
                  <% if (e.calendarId) { %>data-event-calendar-id="<%= e.calendarId %>"<% } %>
                  <% if (e.description) { %>data-event-description="<%= e.description %>"<% } %>
                  <% if (e.allDay) { %>data-event-all-day="1"<% } %>
                  data-cal-agenda-row
                  data-search-text="<%= (e.title + ' ' + (e.description || '')).toLowerCase() %>"
                  class="flex items-center gap-3 w-full px-3 py-2 text-left border-b border-border last:border-b-0 hover:bg-surface-overlay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-border-focus">
                  <span class="w-2 h-2 rounded-full shrink-0 <%= dotCls(e.color) %>" aria-hidden="true"></span>
                  <span class="text-[11px] tabular-nums text-text-secondary w-24 shrink-0">
                    <% if (e.allDay) { %><%= _L.messages.allDay %><% } else { %><%= _fmtTime(e.start) %> – <%= _fmtTime(e.end) %><% } %>
                  </span>
                  <span class="flex-1 min-w-0 text-sm font-medium text-text-primary truncate"><%= e.title %></span>
                  <% if (!e.allDay) { %>
                    <span class="text-[11px] tabular-nums text-text-disabled"><%= _fmtTime(e.start) %></span>
                  <% } %>
                </button>
              </li>
            <% }); %>
          </ul>
        </section>
      <% }); %>
    <% } %>
  </div>
</div>
