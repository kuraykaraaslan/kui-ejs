<%
  // Field row card — pixel-identical to modules/app/FormBuilder/editor/FieldRow.tsx.
  var field = field;
  var index = typeof index === 'number' ? index : 0;
  var ICONS = {
    text:        'fa-font',
    email:       'fa-at',
    number:      'fa-hashtag',
    textarea:    'fa-align-left',
    select:      'fa-caret-down',
    multiselect: 'fa-square-check',
    radio:       'fa-circle-dot',
    checkbox:    'fa-square-check',
    date:        'fa-calendar',
    file:        'fa-paperclip',
    signature:   'fa-signature',
    rating:      'fa-star'
  };
  var LABELS = {
    text: 'Text', email: 'Email', number: 'Number', textarea: 'Textarea',
    select: 'Select', multiselect: 'Multiselect', radio: 'Radio',
    checkbox: 'Checkbox', date: 'Date', file: 'File', signature: 'Signature', rating: 'Rating'
  };
%>
<li
  role="listitem"
  data-field-id="<%= field.id %>"
  data-field-index="<%= index %>"
  class="fb-row group relative rounded-md border bg-surface-base transition-colors border-border hover:border-border-strong"
>
  <button type="button" data-fb-row-select
    class="w-full flex items-start gap-2 px-2 py-2 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus rounded-md">
    <span draggable="true" role="button" tabindex="-1" aria-label="Drag handle" data-fb-row-handle
      class="fb-row-handle shrink-0 grid place-items-center w-6 h-6 rounded text-text-secondary cursor-grab active:cursor-grabbing hover:bg-surface-overlay">
      <i class="fa-solid fa-grip-vertical w-3 h-3" aria-hidden="true"></i>
    </span>
    <span class="flex-1 min-w-0">
      <span class="flex items-center gap-1.5 text-xs uppercase tracking-wide text-text-secondary">
        <i class="fa-solid <%= ICONS[field.type] || 'fa-font' %> w-3 h-3" aria-hidden="true"></i>
        <span><%= LABELS[field.type] || field.type %></span>
        <% if (field.required) { %><span class="text-error" aria-label="required">*</span><% } %>
      </span>
      <span class="block text-sm font-medium text-text-primary truncate"><%= field.label || 'Untitled' %></span>
      <% if (field.helperText) { %>
        <span class="block text-xs text-text-secondary truncate mt-0.5"><%= field.helperText %></span>
      <% } %>
    </span>
  </button>
  <div class="absolute right-1 top-1 flex items-center gap-1 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
    <button type="button" data-fb-row-duplicate aria-label="Duplicate" title="Duplicate"
      class="grid place-items-center w-6 h-6 rounded text-text-secondary hover:text-text-primary hover:bg-surface-overlay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus">
      <i class="fa-solid fa-clone w-3 h-3" aria-hidden="true"></i>
    </button>
    <button type="button" data-fb-row-delete aria-label="Delete" title="Delete"
      class="grid place-items-center w-6 h-6 rounded text-text-secondary hover:text-error hover:bg-error-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus">
      <i class="fa-solid fa-trash w-3 h-3" aria-hidden="true"></i>
    </button>
  </div>
</li>
