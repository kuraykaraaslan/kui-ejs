<%
  var field = field; var value = locals.value || ''; var error = locals.error || '';
  var helperId = field.helperText ? (field.id + '-help') : '';
  var errorId  = error ? (field.id + '-error') : '';
  var describedBy = [helperId, errorId].filter(function (s) { return !!s; }).join(' ');
%>
<div class="fb-field flex flex-col gap-1">
  <label for="<%= field.id %>" class="text-sm font-medium text-text-primary">
    <%= field.label %><% if (field.required) { %><span class="text-error ml-0.5" aria-hidden="true">*</span><% } %>
  </label>
  <input
    id="<%= field.id %>"
    name="<%= field.name %>"
    type="number"
    value="<%= value %>"
    <% if (field.placeholder) { %>placeholder="<%= field.placeholder %>"<% } %>
    <% if (field.required) { %>required aria-required="true"<% } %>
    <% if (error) { %>aria-invalid="true"<% } %>
    <% if (describedBy) { %>aria-describedby="<%= describedBy %>"<% } %>
    class="w-full rounded-md border border-border bg-surface-base px-3 py-2 text-sm text-text-primary placeholder:text-text-disabled focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus aria-[invalid=true]:border-error aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-error/40"
  />
  <% if (field.helperText && !error) { %><p id="<%= helperId %>" class="text-xs text-text-secondary"><%= field.helperText %></p><% } %>
  <% if (error) { %><p id="<%= errorId %>" role="alert" class="text-xs text-error"><%= error %></p><% } %>
</div>
