<!-- Results listbox -->
<div id="<%= _id %>-list" role="listbox" class="max-h-72 overflow-y-auto -mx-4">
  <% var flatIndex = -1; %>
  <% categories.forEach(function(cat) {
    var catItems = _allItems.filter(function(i) { return i.category === cat; });
  %>
  <div class="cmd-category" data-category="<%= cat %>">
    <div class="flex items-center gap-2 mb-1 px-4 pt-2">
      <span class="<%= _badgeNeutralSm %>"><%= cat %></span>
    </div>
    <% catItems.forEach(function(item) { flatIndex++; %>
      <%- include('./_item', { _id: _id, item: item, flatIndex: flatIndex, _badgeNeutralSm: _badgeNeutralSm }) %>
    <% }); %>
  </div>
  <% }); %>

  <!-- Empty state with suggestions (M1) -->
  <div id="<%= _id %>-empty" class="hidden py-4 text-center">
    <p class="text-sm text-text-secondary">No commands found for &quot;<span data-cmd-empty-q></span>&quot;</p>
    <p class="mt-3 text-xs text-text-disabled">Try one of these instead:</p>
    <div class="mt-2 flex flex-wrap justify-center gap-1.5" id="<%= _id %>-empty-sug">
      <% _allItems.slice(0, 4).forEach(function(item) { %>
        <button type="button"
          data-cmd-suggest
          data-suggest-label="<%= item.label %>"
          class="rounded-full border border-border bg-surface-raised px-2.5 py-1 text-xs text-text-secondary hover:bg-surface-overlay transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus"
        ><%= item.label %></button>
      <% }); %>
    </div>
  </div>
</div>
