<%
  // Panel — parallel of parts/Panel.tsx.
  // Locals: id, items, unreadCount, displayUnread, messages, trigger,
  //         formatRelativeTime, VARIANT_ICON, VARIANT_COLOR.
  var drawerLike = trigger === 'drawer';
  var widthClass = drawerLike ? 'w-[24rem]' : 'w-[22rem]';
  var bulkDisabled = unreadCount === 0;
%>
<div
  id="<%= id %>-panel"
  role="region"
  aria-label="<%= messages.panelTitle %>"
  aria-live="polite"
  data-kui-nc-panel
  class="hidden absolute z-[70] mt-2 right-0 <%= widthClass %> max-w-[calc(100vw-1rem)] rounded-lg border border-border bg-surface-base shadow-xl overflow-hidden"
>
  <!-- Header -->
  <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-border bg-surface-raised">
    <div class="flex items-center gap-2 min-w-0">
      <h2 class="text-sm font-semibold text-text-primary truncate"><%= messages.panelTitle %></h2>
      <% if (unreadCount > 0) { %>
        <span class="inline-flex items-center px-1.5 h-5 rounded-full bg-error text-text-inverse text-[10px] font-semibold tabular-nums">
          <%= displayUnread %>
        </span>
      <% } %>
    </div>
    <div class="flex items-center gap-1">
      <!-- BulkActions — M1: only "Mark all as read". -->
      <button
        type="button"
        data-kui-nc-mark-all
        <% if (bulkDisabled) { %>disabled<% } %>
        onclick="window.__KuiNotificationCenter && window.__KuiNotificationCenter.markAllRead('<%= id %>')"
        class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-xs font-medium text-text-secondary hover:text-text-primary hover:bg-surface-overlay disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus transition-colors"
      >
        <i class="fa-solid fa-check w-3 h-3" aria-hidden="true" style="font-size:0.75rem"></i>
        <span><%= messages.markAllRead %></span>
      </button>
      <button
        type="button"
        aria-label="Close"
        onclick="window.__KuiNotificationCenter && window.__KuiNotificationCenter.close('<%= id %>')"
        class="inline-flex items-center justify-center w-7 h-7 rounded-md text-text-secondary hover:text-text-primary hover:bg-surface-overlay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus transition-colors"
      >
        <i class="fa-solid fa-xmark w-3.5 h-3.5" aria-hidden="true" style="font-size:0.875rem"></i>
      </button>
    </div>
  </div>

  <!-- Body -->
  <% if (items.length === 0) { %>
    <%- include('./_empty', { title: messages.emptyTitle, message: messages.emptyMessage }) %>
  <% } else { %>
    <ul class="max-h-[28rem] overflow-y-auto divide-y divide-border" data-kui-nc-list>
      <% items.forEach(function (item) { %>
        <%- include('./_item', {
          id: id,
          item: item,
          markReadLabel: messages.markRead,
          formatRelativeTime: formatRelativeTime,
          VARIANT_ICON: VARIANT_ICON,
          VARIANT_COLOR: VARIANT_COLOR
        }) %>
      <% }); %>
    </ul>
  <% } %>
</div>
