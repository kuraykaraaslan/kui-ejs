<%
  // ─── NotificationCenter — M1 (Bell + panel) ─────────────────────────────────
  //
  // Folder-scoped sibling of
  //   /home/kuray/01_NextJS_Components/modules/app/NotificationCenter/index.tsx
  //
  // File-for-file parallels:
  //   partials/_bell.ejs    ← parts/Bell.tsx
  //   partials/_panel.ejs   ← parts/Panel.tsx
  //   partials/_item.ejs    ← parts/NotificationItem.tsx
  //   partials/_empty.ejs   ← parts/EmptyState.tsx
  //   scripts/store.js      ← React state (open + items + unread bookkeeping)
  //   scripts/unread.js     ← hooks/useUnreadCount.ts (derives badge text)
  //
  // M2-M6 stubs live next to their NextJS siblings as // TODO M* markers.
  // (Filter tabs / grouping / per-notification actions / realtime / preferences
  //  / full a11y).
  //
  // Sibling of NotificationSystem.ejs (toast queue) — both can co-exist.

  var _id          = locals.id          || ('nc-' + Math.random().toString(36).substr(2, 6));
  var _items       = locals.items       || [];
  var _unreadCount = (typeof locals.unreadCount === 'number') ? locals.unreadCount : null;
  var _trigger     = locals.trigger     || 'popover';
  var _className   = locals.className   || '';

  var _messages = Object.assign({
    bellLabel:     'Notifications',
    panelTitle:    'Inbox',
    unreadSuffix:  'unread notifications',
    markAllRead:   'Mark all as read',
    markRead:      'Mark as read',
    emptyTitle:    "You're all caught up",
    emptyMessage:  'New notifications will appear here.'
  }, locals.messages || {});

  // ── Normalise + sort items newest-first (mirror useNotifications). ─────────
  function toMillis(value) {
    if (value instanceof Date) return value.getTime();
    return new Date(value).getTime();
  }
  _items = _items.slice().sort(function (a, b) {
    return toMillis(b.createdAt) - toMillis(a.createdAt);
  });

  // ── Derive unread count when not overridden (mirror useUnreadCount). ──────
  var unreadCount = (_unreadCount != null)
    ? Math.max(0, _unreadCount)
    : _items.reduce(function (n, item) { return item.read ? n : n + 1; }, 0);

  // ── Relative time helper (mirror parts/NotificationItem.tsx). ─────────────
  function formatRelativeTime(value) {
    var d = (value instanceof Date) ? value : new Date(value);
    var diff = Math.floor((Date.now() - d.getTime()) / 1000);
    if (diff < 60)    return Math.max(0, diff) + 's ago';
    if (diff < 3600)  return Math.floor(diff / 60) + 'm ago';
    if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
    var dDay = Math.floor(diff / 86400);
    if (dDay < 7) return dDay + 'd ago';
    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return months[d.getMonth()] + ' ' + d.getDate();
  }

  // ── Variant icon/color tables (mirror parts/NotificationItem.tsx). ────────
  var VARIANT_ICON = {
    info:    'fa-circle-info',
    success: 'fa-circle-check',
    warning: 'fa-triangle-exclamation',
    error:   'fa-circle-xmark',
    mention: 'fa-at',
    system:  'fa-gear'
  };
  var VARIANT_COLOR = {
    info:    'bg-info-subtle text-info',
    success: 'bg-success-subtle text-success',
    warning: 'bg-warning-subtle text-warning',
    error:   'bg-error-subtle text-error',
    mention: 'bg-primary-subtle text-primary',
    system:  'bg-surface-overlay text-text-secondary'
  };

  var displayUnread = unreadCount > 99 ? '99+' : String(unreadCount);
%>
<div
  id="<%= _id %>"
  data-kui-nc
  data-trigger="<%= _trigger %>"
  class="relative inline-block<%= _className ? ' ' + _className : '' %>"
>
  <%- include('./partials/_bell', {
    id: _id,
    unreadCount: unreadCount,
    displayUnread: displayUnread,
    bellLabel: _messages.bellLabel,
    unreadSuffix: _messages.unreadSuffix
  }) %>

  <%- include('./partials/_panel', {
    id: _id,
    items: _items,
    unreadCount: unreadCount,
    displayUnread: displayUnread,
    messages: _messages,
    trigger: _trigger,
    formatRelativeTime: formatRelativeTime,
    VARIANT_ICON: VARIANT_ICON,
    VARIANT_COLOR: VARIANT_COLOR
  }) %>
</div>

<%- include('./scripts/store.js') %>
<%- include('./scripts/unread.js') %>
