{
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "modules/**",
        "views/**",
        "public/assets/**",
        "public/registry/**",
        "public/components/**",
        "public/schemas/**",
        "public/llms.txt"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
